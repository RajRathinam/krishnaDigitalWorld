{
  "expo": {
    "name": "Sri Krishna Digital",
    "slug": "sri-krishna-digital",
    "version": "1.0.2",
    "orientation": "portrait",
    "icon": "./assets/images/skdw.png",
    "scheme": "mobileapp",
    "userInterfaceStyle": "automatic",
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#0d001a"
    },
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "LSApplicationQueriesSchemes": [
          "phonepe",
          "tezz",
          "paytm",
          "bhim"
        ]
      }
    },
    "android": {
      "usesCleartextTraffic": true,
      "package": "com.srikrishnadigital.app",
      "versionCode": 3,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/skdw.png",
        "backgroundColor": "#ffffff"
      },
      "predictiveBackGestureEnabled": false,
      "notification": {
        "icon": "./assets/images/sk.png",
        "color": "#FFC107"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-web-browser",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/sk.png",
          "color": "#FFC107",
          "defaultChannel": "default",
          "sounds": []
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "cbb04819-c22b-49a3-82ab-c2d8bd7d616d"
      }
    },
    "owner": "infygridsolutions"
  }
}
